[Unit]
Description=VPSDeck web control panel
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=vpsdeck
Group=vpsdeck
WorkingDirectory=/opt/vpsdeck/src
Environment=HOME=/var/lib/vpsdeck
Environment=PATH=/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
# Optional GitHub OAuth secrets (created by scripts/enable-github.sh). The leading
# dash means the service still starts if the file is absent.
EnvironmentFile=-/etc/vpsdeck/github.env
ExecStart=/usr/local/bin/vpsdeck -config /etc/vpsdeck/config.yaml
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
